diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,6 +21,15 @@
 option(REXGLUE_BUILD_TESTS       "Build PPC instruction and unit tests" OFF)
 option(REXGLUE_ENABLE_SANITIZERS "Enable UndefinedBehaviorSanitizer" OFF)
 option(REXGLUE_ENABLE_FIDELITYFX "Enable optional AMD FidelityFX integration (experimental)" OFF)
+# FSR1/CAS use shader bytecode already embedded in the pinned source. They do
+# not require the temporal SDK, fabricated motion vectors, or extra downloads.
+option(ASTER_ENABLE_SPATIAL_FILTERS "Enable embedded spatial EASU/RCAS/CAS" OFF)
+if(ASTER_ENABLE_SPATIAL_FILTERS)
+    if(REXGLUE_ENABLE_FIDELITYFX)
+        message(FATAL_ERROR "Aster spatial runtime excludes experimental temporal FidelityFX")
+    endif()
+    add_compile_definitions(REX_HAS_FIDELITYFX_SDK=1 ASTER_SPATIAL_ONLY=1)
+endif()
 option(REXGLUE_ENABLE_TRACY                "Enable Tracy profiler integration" ON)
 option(REXGLUE_ENABLE_PERF_COUNTERS        "Enable lightweight perf counter registry and overlay" ON)
 # Propagate profiling defines globally (compiled out in Release)
diff --git a/src/ui/presenter.cpp b/src/ui/presenter.cpp
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -42,8 +42,12 @@
 
 #if defined(REX_HAS_FIDELITYFX_SDK)
 REXCVAR_DEFINE_STRING(present_effect, "bilinear", "UI/Presenter",
-                      "Guest output effect: bilinear, cas, fsr, fsr2, fsr3")
+                      "Guest output effect: bilinear, cas, fsr")
+#if defined(ASTER_SPATIAL_ONLY)
+    .allowed({"bilinear", "cas", "fsr"})
+#else
     .allowed({"bilinear", "cas", "fsr", "fsr2", "fsr3"})
+#endif
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
 REXCVAR_DEFINE_DOUBLE(present_cas_additional_sharpness,
@@ -99,12 +103,14 @@
   if (lowered == "fsr") {
     return GuestOutputPaintConfig::Effect::kFsr;
   }
+#if !defined(ASTER_SPATIAL_ONLY)
   if (lowered == "fsr2") {
     return GuestOutputPaintConfig::Effect::kFsr2;
   }
   if (lowered == "fsr3") {
     return GuestOutputPaintConfig::Effect::kFsr3;
   }
+#endif
 #endif
   return GuestOutputPaintConfig::Effect::kBilinear;
 }
diff --git a/cmake/rexglueConfig.cmake.in b/cmake/rexglueConfig.cmake.in
--- a/cmake/rexglueConfig.cmake.in
+++ b/cmake/rexglueConfig.cmake.in
@@ -38,6 +38,13 @@
 
 include("${CMAKE_CURRENT_LIST_DIR}/rexglueTargets.cmake")
 
+# The presenter class layout changes with the embedded spatial shader option.
+# Propagate the exact ABI to every consumer, including generated game hosts.
+if(@ASTER_ENABLE_SPATIAL_FILTERS@)
+    target_compile_definitions(rex::runtime INTERFACE
+        REX_HAS_FIDELITYFX_SDK=1 ASTER_SPATIAL_ONLY=1)
+endif()
+
 # Only Release rexglue is installed, so every consumer config has to reach it.
 if(TARGET rex::rexglue)
     set_target_properties(rex::rexglue PROPERTIES
