+std::function<void()> ImGuiDrawer::MakeThreadSafePaintRequest() const {
+  // Generic contexts may implement a blocking wakeup pipe. Never hold the
+  // lifetime gate across such an enqueue while UI teardown could be waiting.
+  // SDL's final context posts SDL_PushEvent and does not wait for UI dequeue.
+  if (!dynamic_cast<SDLWindowedAppContext*>(&window_->app_context())) return {};
+  std::weak_ptr<PaintRequestState> weak_state = paint_request_state_;
+  return [weak_state]() {
+    auto state = weak_state.lock();
+    if (!state) return;
+    // Keep the gate through enqueue: teardown cannot leave an in-flight caller
+    // accessing the app context after invalidation has returned.
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (!state->context) return;
+    // Never capture the dialog/drawer/context itself in the deferred callback.
+    state->context->CallInUIThreadDeferred([weak_state]() {
+      auto state = weak_state.lock();
+      if (!state) return;
+      std::lock_guard<std::mutex> lock(state->mutex);
+      if (state->window) state->window->RequestPaint();
+    });
+  };
+}
