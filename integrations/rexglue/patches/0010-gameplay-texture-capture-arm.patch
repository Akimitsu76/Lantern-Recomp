new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/pipeline/texture/capture_policy.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <charconv>
+#include <cstdlib>
+#include <filesystem>
+#include <string_view>
+
+namespace rex::graphics {
+struct TextureCapturePolicy {
+  size_t max_count = 16, max_bytes = 64u << 20;
+  static size_t Bounded(const char* text, size_t fallback, size_t maximum) {
+    if (!text || !*text) return fallback;
+    const std::string_view value(text);
+    size_t parsed = 0;
+    const auto result = std::from_chars(value.data(), value.data() + value.size(), parsed);
+    return result.ec == std::errc{} && result.ptr == value.data() + value.size() &&
+        parsed > 0 && parsed <= maximum ? parsed : fallback;
+  }
+  static TextureCapturePolicy FromEnvironment() {
+    return {Bounded(std::getenv("ASTER_TEXTURE_CAPTURE_MAX_COUNT"), 16, 256),
+            Bounded(std::getenv("ASTER_TEXTURE_CAPTURE_MAX_MIB"), 64, 256) << 20};
+  }
+  static bool IsArmed() {
+    const char* arm = std::getenv("ASTER_TEXTURE_CAPTURE_START_FILE");
+    if (!arm || !*arm) return true;  // Legacy explicit capture remains supported.
+    std::error_code error;
+    const auto path = std::filesystem::u8path(arm);
+    return !std::filesystem::is_symlink(path, error) &&
+        std::filesystem::is_regular_file(path, error) && !error;
+  }
+};
+}  // namespace rex::graphics
