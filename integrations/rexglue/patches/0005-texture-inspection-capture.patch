+
+bool SharedMemory::TrySnapshotCpuTexture(uint32_t start, uint32_t length,
+                                         std::vector<uint8_t>& snapshot) {
+  snapshot.clear();
+  // Bound allocations even if inspection callers are changed later.
+  if (!length || length > (16u << 20) || start >= kBufferSize ||
+      length > kBufferSize - start) {
+    return false;
+  }
+  auto lock = global_critical_region_.Acquire();
+  const uint32_t first = start >> page_size_log2_;
+  const uint32_t last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t page = first; page <= last; ++page) {
+    const uint64_t mask = uint64_t(1) << (page & 63);
+    if (page / 64 >= system_page_flags_valid_.size() ||
+        !(system_page_flags_valid_[page / 64] & mask) ||
+        (system_page_flags_valid_and_gpu_written_[page / 64] & mask)) {
+      return false;
+    }
+  }
+  const auto* source = memory_.TranslatePhysical<const uint8_t*>(start);
+  snapshot.assign(source, source + length);
+  // CPU writes can resume after their invalidation callback. Reject a visibly
+  // changing snapshot too; this still does not establish long-term immutability.
+  return std::memcmp(snapshot.data(), source, length) == 0;
 }
 
