+      if (properties && !SDL_GetBooleanProperty(properties, retry_key, false)) {
+        SDL_SetBooleanProperty(properties, retry_key, true);
+        if (IsFullscreen() && !(SDL_GetWindowFlags(sdl_window_) & SDL_WINDOW_FULLSCREEN)) {
+          if (!SDL_SetWindowFullscreen(sdl_window_, true)) {
+            REXLOG_WARN("Failed to retry startup fullscreen: {}", SDL_GetError());
+          }
+          if (destruction_receiver.IsWindowDestroyed()) {
+            return;
+          }
+        }
+      }
       OnFocusUpdate(true, destruction_receiver);
       break;
+    }
     case SDL_EVENT_WINDOW_FOCUS_LOST:
