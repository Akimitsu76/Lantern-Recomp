+#pragma once
+// Aster experimental single-material replacement. No game assets embedded.
+// Deliberately opt-in and restricted to reviewed opaque color DXT1/DXT5.
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/graphics/pipeline/texture/conversion.h>
+#include <rex/graphics/pipeline/texture/util.h>
