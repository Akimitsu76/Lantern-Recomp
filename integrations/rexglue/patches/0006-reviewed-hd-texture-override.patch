+#include <span>
+#include <string>
+#include <vector>
+
+namespace rex::graphics {
+inline bool IsHDTextureFetchEligible(const ParsedTextureFetchInstruction& fetch) {
+  const auto& a = fetch.attributes;
+  return fetch.opcode == ucode::FetchOpcode::kTextureFetch &&
+      fetch.dimension == xenos::FetchOpDimension::k2D &&
+      !a.unnormalized_coordinates && a.use_computed_lod &&
+      !a.use_register_lod && !a.use_register_gradients && a.lod_bias == 0.0f &&
+      a.offset_x == 0.0f && a.offset_y == 0.0f && a.offset_z == 0.0f;
+}
+inline bool IsHDTextureDrawEligible(const Shader* vertex, const Shader* pixel) {
+  if (!pixel || pixel->texture_bindings().empty() ||
+      (vertex && !vertex->texture_bindings().empty())) return false;
+  for (const auto& binding : pixel->texture_bindings())
+    if (!IsHDTextureFetchEligible(binding.fetch_instr)) return false;
+  return true;
+}
+struct HDTextureReplacement {
+  struct Mip { uint32_t width, height, row_bytes, rows; size_t offset, size; };
+  uint32_t source_format = 0, source_width = 0, source_height = 0;
+  uint32_t width = 0, height = 0;
+  std::string canonical_bc_xxh3_128;
+  std::vector<uint8_t> bytes;
+  std::vector<Mip> mips;
+};
+inline bool IsHDFingerprint(const std::string& value) {
+  return value.size() == 32 && value.find_first_not_of("0123456789abcdef") == std::string::npos;
+}
+inline uint32_t HDReadWord(const std::vector<uint8_t>& data, size_t offset) {
+  return uint32_t(data[offset]) | (uint32_t(data[offset + 1]) << 8) |
+      (uint32_t(data[offset + 2]) << 16) | (uint32_t(data[offset + 3]) << 24);
+}
+inline std::shared_ptr<const HDTextureReplacement> LoadHDTextureReplacement() {
+  // A pack is immutable for this process. Changing files requires a restart.
+  static const auto pack = []() -> std::shared_ptr<const HDTextureReplacement> {
+    try {
+      const char* directory = std::getenv("ASTER_HD_TEXTURE_PACK_DIR");
+      if (!directory || !*directory) return {};
+      const auto path = std::filesystem::u8path(directory);
+      std::ifstream index(path / "texture.index");
+      std::string magic, expected_dds_hash, classification, trailing;
+      auto result = std::make_shared<HDTextureReplacement>();
+      if (!(index >> magic >> result->source_format >> result->source_width >>
+            result->source_height >> result->canonical_bc_xxh3_128 >>
+            expected_dds_hash >> classification) || (index >> trailing) ||
+          magic != "ASTERHD1" || classification != "reviewed-color-opaque" ||
+          (result->source_format != 18 && result->source_format != 20) ||
+          result->source_width < 64 || result->source_height < 64 ||
+          result->source_width > 2048 || result->source_height > 2048 ||
+          !IsHDFingerprint(result->canonical_bc_xxh3_128) ||
+          !IsHDFingerprint(expected_dds_hash)) return {};
+      std::ifstream file(path / "texture.dds", std::ios::binary | std::ios::ate);
+      const auto length = file.tellg();
+      if (!file || length < 128 || length > (64 << 20)) return {};
+      std::vector<uint8_t> dds(static_cast<size_t>(length));
+      file.seekg(0); file.read(reinterpret_cast<char*>(dds.data()), dds.size());
+      if (!file || rex::hash_bytes(std::string_view(
+          reinterpret_cast<const char*>(dds.data()), dds.size())) != expected_dds_hash)
+        return {};
+      if (HDReadWord(dds, 0) != 0x20534444 || HDReadWord(dds, 4) != 124 ||
+          HDReadWord(dds, 76) != 32 || HDReadWord(dds, 80) != 4 ||
+          HDReadWord(dds, 112) != 0) return {};  // No cubes/volume/DX10 extensions.
+      result->width = HDReadWord(dds, 16); result->height = HDReadWord(dds, 12);
+      const uint32_t format = HDReadWord(dds, 84);
+      if (result->width != result->source_width * 2 ||
+          result->height != result->source_height * 2 ||
+          format != (result->source_format == 18 ? 0x31545844u : 0x35545844u)) return {};
+      uint32_t w = result->width, h = result->height, count = 0;
+      size_t offset = 0;
+      const uint32_t block_bytes = result->source_format == 18 ? 8 : 16;
+      do {
+        const uint32_t row = ((w + 3) / 4) * block_bytes, rows = (h + 3) / 4;
+        const size_t size = size_t(row) * rows;
+        result->mips.push_back({w, h, row, rows, offset, size});
+        offset += size; ++count;
+        if (w == 1 && h == 1) break;
+        w = std::max(1u, w >> 1); h = std::max(1u, h >> 1);
+      } while (count < 14);
+      if (HDReadWord(dds, 28) != count || offset + 128 != dds.size() ||
+          result->mips.back().width != 1 || result->mips.back().height != 1) return {};
+      result->bytes.assign(dds.begin() + 128, dds.end());
+      return result;
+    } catch (const std::exception&) { return {}; }
+  }();
+  return pack;
+}
+inline bool HDCanonicalBlocks(std::span<const uint8_t> raw, uint32_t width,
+    uint32_t height, uint32_t row_pitch, uint32_t format, uint32_t endian,
+    bool tiled, std::vector<uint8_t>& linear) {
+  if ((format != 18 && format != 20) || endian > 3 || !width || !height ||
+      width > 2048 || height > 2048) return false;
+  const uint32_t bpb = format == 18 ? 8 : 16, nx = (width + 3) / 4, ny = (height + 3) / 4;
+  if (row_pitch % bpb || row_pitch < nx * bpb || (tiled && ((row_pitch / bpb) & 31))) return false;
+  linear.resize(size_t(nx) * ny * bpb);
+  for (uint32_t y = 0; y < ny; ++y) for (uint32_t x = 0; x < nx; ++x) {
+    const int64_t offset = tiled ? texture_util::GetTiledOffset2D(x, y, row_pitch / bpb,
+        bpb == 8 ? 3 : 4) : int64_t(y) * row_pitch + x * bpb;
+    if (offset < 0 || uint64_t(offset) + bpb > raw.size()) return false;
+    const uint8_t* src = raw.data() + offset;
+    uint8_t* dst = linear.data() + (size_t(y) * nx + x) * bpb;
+    if (endian == 3) {
+      for (uint32_t i = 0; i < bpb; i += 4) {
+        dst[i] = src[i + 2]; dst[i + 1] = src[i + 3];
+        dst[i + 2] = src[i]; dst[i + 3] = src[i + 1];
+      }
+    } else {
+      texture_conversion::CopySwapBlock(static_cast<xenos::Endian>(endian), dst, src, bpb);
+    }
+  }
+  return true;
+}
+}  // namespace rex::graphics
