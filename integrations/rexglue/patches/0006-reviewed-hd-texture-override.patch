+void TextureCache::RetireInvalidHDTextures() {
+  bool reset = false;
+  for (auto it = hd_textures_.begin(); it != hd_textures_.end();) {
+    if (!it->second->outdated_mask() && !it->second->hd_failed()) { ++it; continue; }
+    it->second->DetachForRetirement();
+    retired_hd_textures_.push_back(std::move(it->second));
+    it = hd_textures_.erase(it);
+    reset = true;
+  }
+  if (reset) ResetTextureBindings();
+}
