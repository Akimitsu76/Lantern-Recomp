+// At most 16 decision records per explicitly enabled process. No texture bytes
+// or extra snapshots; rejection paths retain all original source checks.
+inline bool DecisionOnce(uint32_t index) {
+  if (!Enabled() || index >= 16) return false;
+  static std::atomic<uint32_t> observed{0};
+  const uint32_t bit = uint32_t(1) << index;
+  return !(observed.fetch_or(bit, std::memory_order_relaxed) & bit);
+}
