+// CPU source retention is independent of GPU texture residency. Only already
+// validated immutable replacements enter this cache; first loads still use the
+// full DDS/hash/path checks below. Callers serialize access with library_mutex.
+// The limit counts retained byte-vector and mip-vector capacities, not VRAM.
+class HDSourceCache {
+ public:
+  static constexpr size_t kDefaultBudget = size_t(128) << 20;
+  explicit HDSourceCache(size_t budget = kDefaultBudget) : budget_(budget) {}
+  HDSourceCache(const HDSourceCache&) = delete;
+  HDSourceCache& operator=(const HDSourceCache&) = delete;
+  size_t RetainedBytes() const { return retained_bytes_; }
+  size_t RetainedCount() const { return index_.size(); }
+  size_t BudgetBytes() const { return budget_; }
+  void Remember(const std::string& fingerprint,
+                const std::shared_ptr<const HDTextureReplacement>& image) noexcept {
+    if (!image) return;
+    // Caching must never turn a successfully validated image into a failed load.
+    // Allocation failure leaves the ordinary weak-resident path available.
+    try {
+      auto existing = index_.find(fingerprint);
+      if (existing != index_.end()) {
+        entries_.splice(entries_.begin(), entries_, existing->second);
+        return;
+      }
+      if (image->mips.capacity() > budget_ / sizeof(HDTextureReplacement::Mip)) return;
+      const size_t mip_bytes = image->mips.capacity() * sizeof(HDTextureReplacement::Mip);
+      if (image->bytes.capacity() > budget_ - mip_bytes) return;
+      const size_t cost = image->bytes.capacity() + mip_bytes;
+      // Do not retain empty records or displace useful entries for an oversized one.
+      if (!cost) return;
+      entries_.push_front({fingerprint, image, cost});
+      try {
+        index_.emplace(fingerprint, entries_.begin());
+      } catch (...) {
+        entries_.pop_front();
+        return;
+      }
+      retained_bytes_ += cost;
+      while (retained_bytes_ > budget_) {
+        const auto& oldest = entries_.back();
+        index_.erase(oldest.fingerprint);
+        retained_bytes_ -= oldest.cost;
+        entries_.pop_back();
+      }
+    } catch (...) {}
+  }
+ private:
+  struct Entry {
+    std::string fingerprint;
+    std::shared_ptr<const HDTextureReplacement> image;
+    size_t cost;
+  };
+  const size_t budget_;
+  size_t retained_bytes_ = 0;
+  std::list<Entry> entries_;
+  std::unordered_map<std::string, std::list<Entry>::iterator> index_;
+};
