+// A local index can be created after uploads from this same process are reviewed.
+// It is polled at most once per second until the first valid file, then immutable.
+struct Source {
+  std::string fingerprint;
+  uint32_t width, height, pitch, extent;
+  bool MatchesGeometry(uint32_t w, uint32_t h, uint32_t p, uint32_t e) const {
+    return width == w && height == h && pitch == p && extent == e;
+  }
+};
+inline bool ValidSource(const Source& s) {
+  if (s.fingerprint.size() != 32 || s.width < 64 || s.width > 2048 ||
+      s.height < 64 || s.height > 2048 || !s.pitch || s.pitch > 64 ||
+      s.pitch * 32 < s.width || !s.extent || s.extent > (4u << 20)) return false;
+  for (char c : s.fingerprint)
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+  return true;
+}
+using Sources = std::vector<Source>;
+inline bool SourceUnsigned(const std::string& token, uint32_t& value) {
+  if (token.empty() || token.size() > 10) return false;
+  uint64_t parsed = 0;
+  for (char c : token) {
+    if (c < '0' || c > '9') return false;
+    parsed = parsed * 10 + uint64_t(c - '0');
+    if (parsed > UINT32_MAX) return false;
+  }
+  value = uint32_t(parsed);
+  return true;
+}
+inline std::shared_ptr<const Sources> ParseSourceIndex(const std::string& text) {
+  if (text.empty() || text.size() > (16u << 10)) return {};
+  std::istringstream stream(text);
+  std::string line;
+  if (!std::getline(stream, line)) return {};
+  if (!line.empty() && line.back() == '\r') line.pop_back();
+  if (line != "ASTERFX1") return {};
+  Sources sources;
+  std::unordered_set<std::string> hashes;
+  while (std::getline(stream, line)) {
+    if (sources.size() >= 8 || line.empty()) return {};
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::istringstream row(line);
+    Source source;
+    std::string width, height, pitch, extent, extra;
+    if (!(row >> source.fingerprint >> width >> height >> pitch >> extent) || (row >> extra) ||
+        !SourceUnsigned(width, source.width) || !SourceUnsigned(height, source.height) ||
+        !SourceUnsigned(pitch, source.pitch) || !SourceUnsigned(extent, source.extent) ||
+        !ValidSource(source) || !hashes.insert(source.fingerprint).second) return {};
+    sources.push_back(std::move(source));
+  }
+  if (sources.empty()) return {};
+  return std::make_shared<const Sources>(std::move(sources));
+}
+class SourceIndex {
+ public:
+  explicit SourceIndex(std::filesystem::path path) : path_(std::move(path)) {}
+  std::shared_ptr<const Sources> Poll(uint64_t now_ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (sources_) return sources_;
+    if (polled_ && (now_ms < last_poll_ms_ || now_ms - last_poll_ms_ < 1000)) return {};
+    polled_ = true;
+    last_poll_ms_ = now_ms;
+    try {
+      std::error_code error;
+      if (path_.empty() || !std::filesystem::is_regular_file(path_, error) || error) return {};
+      const auto size = std::filesystem::file_size(path_, error);
+      if (error || !size || size > (16u << 10)) return {};
+      std::ifstream file(path_, std::ios::binary);
+      if (!file) return {};
+      std::string text(size_t(size), '\0');
+      if (!file.read(text.data(), std::streamsize(text.size())) ||
+          file.peek() != std::ifstream::traits_type::eof()) return {};
+      sources_ = ParseSourceIndex(text);
+    } catch (const std::exception&) {
+      // A missing, partial or invalid file must not arm source inspection.
+    }
+    return sources_;
+  }
+ private:
+  const std::filesystem::path path_;
+  std::mutex mutex_;
+  bool polled_ = false;
+  uint64_t last_poll_ms_ = 0;
+  std::shared_ptr<const Sources> sources_;
+};
+inline std::pair<bool, std::filesystem::path> SourceIndexEnvironment() {
+#ifdef _WIN32
+  const wchar_t* value = ::_wgetenv(L"ASTER_EFFECTS_SOURCE_INDEX");
+  return value ? std::make_pair(true, std::filesystem::path(value)) :
+      std::make_pair(false, std::filesystem::path());
+#else
+  const char* value = std::getenv("ASTER_EFFECTS_SOURCE_INDEX");
+  return value ? std::make_pair(true, std::filesystem::u8path(value)) :
+      std::make_pair(false, std::filesystem::path());
+#endif
+}
+struct SourceSelection {
+  explicit SourceSelection(std::pair<bool, std::filesystem::path> environment)
+      : local(environment.first), index(std::move(environment.second)) {}
+  const bool local;
+  SourceIndex index;
+  const std::shared_ptr<const Sources> fallback = std::make_shared<const Sources>(Sources{
+      {"20d7f7023b337e4a3b25e2d40cd10280", 1440, 1344, 48, 2162688}});
+  std::shared_ptr<const Sources> Get() {
+    if (!local) return fallback;
+    const auto now = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+    return index.Poll(now);
+  }
+};
+inline SourceSelection& Selection() {
+  static SourceSelection selection(SourceIndexEnvironment());
+  return selection;
+}
+inline bool HasGeometry(const Sources& sources, uint32_t w, uint32_t h, uint32_t p) {
+  for (const auto& source : sources)
+    if (source.width == w && source.height == h && source.pitch == p) return true;
+  return false;
+}
+inline const Source* FindSource(const Sources& sources, uint32_t w, uint32_t h,
+    uint32_t p, uint32_t extent, const std::string* fingerprint = nullptr) {
+  for (const auto& source : sources)
+    if (source.MatchesGeometry(w, h, p, extent) &&
+        (!fingerprint || source.fingerprint == *fingerprint)) return &source;
+  return nullptr;
+}
