+inline uint64_t HDExpectedDDSSize(uint32_t format, uint32_t width, uint32_t height,
+                                uint32_t scale) {
+  uint64_t size = 128;
+  width *= scale; height *= scale;
+  do {
+    size += uint64_t((width + 3) / 4) * ((height + 3) / 4) * (format == 18 ? 8 : 16);
+    if (width == 1 && height == 1) return size;
+    width = std::max(1u, width >> 1); height = std::max(1u, height >> 1);
+  } while (true);
+}
+inline std::shared_ptr<const HDTexturePack> HDReadCampaignLibrary(
+    const std::filesystem::path& root, const std::string& text) {
+  if (text.size() > (4u << 20)) return {};
+  std::istringstream stream(text);
+  std::string line, magic, trailing;
+  uint32_t count = 0;
+  if (!std::getline(stream, line)) return {};
+  std::istringstream header(line);
+  if (!(header >> magic >> count) || (header >> trailing) || magic != "ASTERHDLIB1" ||
+      !count || count > 16384) return {};
+  auto result = std::make_shared<HDTexturePack>();
+  result->library_entries.reserve(count);
+  uint64_t total_bytes = 0;
+  std::unordered_set<std::string> directories;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (!std::getline(stream, line)) return {};
+    std::istringstream row(line);
+    std::string fingerprint, relative;
+    HDTexturePack::LibraryEntry entry;
+    if (!(row >> fingerprint >> relative >> entry.source_format >> entry.source_width >>
+          entry.source_height >> entry.dds_hash >> entry.dds_size) || (row >> trailing) ||
+        !IsHDFingerprint(fingerprint) || !IsHDFingerprint(entry.dds_hash) ||
+        !HDRelativeDirectory(relative) || result->library_entries.contains(fingerprint) ||
+        !directories.insert(relative).second ||
+        (entry.source_format != 18 && entry.source_format != 20) ||
+        entry.source_width < 64 || entry.source_height < 64 ||
+        entry.source_width > 2048 || entry.source_height > 2048 ||
+        (entry.source_width & (entry.source_width - 1)) ||
+        (entry.source_height & (entry.source_height - 1)) ||
+        entry.dds_size < 128 || entry.dds_size > (128u << 20) ||
+        (entry.dds_size != HDExpectedDDSSize(entry.source_format, entry.source_width, entry.source_height, 2) &&
+         entry.dds_size != HDExpectedDDSSize(entry.source_format, entry.source_width, entry.source_height, 4)) ||
+        entry.dds_size > (uint64_t(64) << 30) - total_bytes) return {};
+    total_bytes += entry.dds_size;
+    entry.directory = root / std::filesystem::u8path(relative);
+    result->geometries.insert(HDTexturePack::Geometry(entry.source_format,
+        entry.source_width, entry.source_height));
+    result->library_entries.emplace(fingerprint, std::move(entry));
+  }
+  // Exactly count records; additional blank records are rejected too.
+  if (std::getline(stream, line)) return {};
+  return result;
+}
