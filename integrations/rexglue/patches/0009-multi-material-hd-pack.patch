+inline std::shared_ptr<const HDTexturePack> LoadHDTexturePack() {
+  // Validate the entire bounded pack before enabling any replacement. Bad entries
+  // reject the whole pack; changing files requires restarting this process.
+  static const auto pack = []() -> std::shared_ptr<const HDTexturePack> {
+    try {
+      const char* directory = std::getenv("ASTER_HD_TEXTURE_PACK_DIR");
+      if (!directory || !*directory) return {};
+      const auto root = std::filesystem::u8path(directory);
+      if (!HDPathWithoutSymlinks(root) || !std::filesystem::is_directory(root)) return {};
+      auto result = std::make_shared<HDTexturePack>();
+      size_t remaining = 256u << 20;
+      if (!std::filesystem::exists(std::filesystem::symlink_status(root / "texture-pack.index"))) {
+        auto entry = HDReadReplacement(root, remaining);
+        if (!entry) return {};
+        result->entries.emplace(entry->canonical_bc_xxh3_128, std::move(entry));
+        return result;
+      }
+      std::string text;
+      if (!HDReadSmallFile(root / "texture-pack.index", 65536, text)) return {};
+      std::istringstream stream(text);
+      std::string line, magic, trailing;
+      uint32_t count = 0;
+      if (!std::getline(stream, line)) return {};
+      std::istringstream header(line);
+      if (!(header >> magic >> count) || (header >> trailing) || magic != "ASTERHDPACK1" ||
+          !count || count > 256) return {};
+      for (uint32_t i = 0; i < count; ++i) {
+        if (!std::getline(stream, line)) return {};
+        std::istringstream row(line);
+        std::string fingerprint, relative;
+        if (!(row >> fingerprint >> relative) || (row >> trailing) ||
+            !IsHDFingerprint(fingerprint) || !HDRelativeDirectory(relative) ||
+            result->entries.contains(fingerprint)) return {};
+        auto entry = HDReadReplacement(root / std::filesystem::u8path(relative), remaining);
+        if (!entry || entry->canonical_bc_xxh3_128 != fingerprint) return {};
+        result->entries.emplace(fingerprint, std::move(entry));
+      }
+      // No extra records, including blank records, after the declared count.
+      if (std::getline(stream, line)) return {};
       return result;
     } catch (const std::exception&) { return {}; }
   }();
   return pack;
+}
+// Compatibility accessor for legacy single-material consumers and tests.
+inline std::shared_ptr<const HDTextureReplacement> LoadHDTextureReplacement() {
+  const auto pack = LoadHDTexturePack();
+  return pack && pack->entries.size() == 1 ? pack->entries.begin()->second : nullptr;
 }
