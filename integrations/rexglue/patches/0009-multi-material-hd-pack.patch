+// Reject links in every path component. Loaded bytes are immutable thereafter.
+// Packs must not be concurrently edited while they are being loaded.
+inline bool HDPathWithoutSymlinks(const std::filesystem::path& path) {
+  const auto absolute = std::filesystem::absolute(path).lexically_normal();
+  std::filesystem::path current;
+  for (const auto& component : absolute) {
+    current /= component;
+    const auto status = std::filesystem::symlink_status(current);
+    if (!std::filesystem::exists(status) || std::filesystem::is_symlink(status)) return false;
+  }
+  // Also catches Windows directory junctions that canonicalization resolves.
+  return std::filesystem::canonical(absolute) == absolute;
+}
+inline bool HDReadSmallFile(const std::filesystem::path& path, size_t limit, std::string& text) {
+  if (!HDPathWithoutSymlinks(path) || !std::filesystem::is_regular_file(path)) return false;
+  std::ifstream file(path, std::ios::binary | std::ios::ate);
+  const auto length = file.tellg();
+  if (!file || length < 0 || uint64_t(length) > limit) return false;
+  text.resize(size_t(length));
+  file.seekg(0); file.read(text.data(), text.size());
+  return bool(file);
+}
+inline bool HDRelativeDirectory(const std::string& value) {
+  if (value.empty() || value.size() > 192 || value.front() == '/' || value.back() == '/') return false;
+  size_t start = 0;
+  while (start < value.size()) {
+    const auto end = value.find('/', start);
+    const auto component = value.substr(start, end == std::string::npos ? end : end - start);
+    if (component.empty() || component == "." || component == ".." ||
