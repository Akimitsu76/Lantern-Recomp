+struct HDTexturePack {
+  std::unordered_map<std::string, std::shared_ptr<const HDTextureReplacement>> entries;
+  bool HasGeometry(uint32_t format, uint32_t width, uint32_t height) const {
+    for (const auto& entry : entries) {
+      const auto& replacement = *entry.second;
+      if (replacement.source_format == format && replacement.source_width == width &&
+          replacement.source_height == height) return true;
+    }
+    return false;
+  }
