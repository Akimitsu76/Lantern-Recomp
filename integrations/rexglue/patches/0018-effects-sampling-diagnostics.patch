+// Optional, bounded source/metadata inspection. No render state is changed.
+#ifndef REX_GRAPHICS_PIPELINE_TEXTURE_EFFECTS_DIAGNOSTICS_H_
+#define REX_GRAPHICS_PIPELINE_TEXTURE_EFFECTS_DIAGNOSTICS_H_
+#include <cstdint>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+namespace rex::graphics::effects_diagnostics {
+inline bool IsEnabledValue(const char* value) {
+  return value && value[0] == '1' && value[1] == '\0';
+}
+inline bool Enabled() {
+  static const bool enabled = IsEnabledValue(std::getenv("ASTER_EFFECTS_DIAGNOSTICS"));
+  return enabled;
+}
+// Failed fingerprints/snapshots consume the budget too: <=32 snapshots/process.
+// Reservation precedes the snapshot, so repeated draws never re-read that state.
+class StateBudget {
+ public:
+  static constexpr size_t kMaxStates = 32;
+  bool Full() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return seen_.size() >= kMaxStates;
+  }
+  bool Reserve(const std::string& state) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (seen_.size() >= kMaxStates) return false;
+    return seen_.insert(state).second;
+  }
+ private:
+  mutable std::mutex mutex_;
+  std::unordered_set<std::string> seen_;
+};
+inline StateBudget& Budget() { static StateBudget budget; return budget; }
+struct Sampler {
+  uint32_t stage, fetch, instruction_mag, instruction_min, instruction_mip;
+  uint32_t instruction_aniso, host_value, mag_linear, min_linear, mip_linear;
+  uint32_t aniso, mip_min_level, mip_base_map, clamp_x, clamp_y, clamp_z, border;
+};
+template <typename Binding, typename Parameters>
+Sampler MakeSampler(uint32_t stage, const Binding& binding, Parameters p) {
+  return {stage, binding.fetch_constant, uint32_t(binding.mag_filter),
+    uint32_t(binding.min_filter), uint32_t(binding.mip_filter), uint32_t(binding.aniso_filter),
+    p.value, p.mag_linear, p.min_linear, p.mip_linear, uint32_t(p.aniso_filter),
+    p.mip_min_level, p.mip_base_map, uint32_t(p.clamp_x), uint32_t(p.clamp_y),
+    uint32_t(p.clamp_z), uint32_t(p.border_color)};
+}
+}  // namespace rex::graphics::effects_diagnostics
+#endif
