+uint32_t TextureCache::GetEffectsDiagnosticCandidateMask(uint32_t used_texture_mask) const {
+  if (!effects_diagnostics::Enabled() || effects_diagnostics::Budget().Full()) return 0;
+  uint32_t mask = 0;
+  for (uint32_t i = 0; i < xenos::kTextureFetchConstantCount; ++i) {
+    if (!(used_texture_mask & (uint32_t(1) << i))) continue;
+    const TextureBinding* binding = GetValidTextureBinding(i);
+    if (!binding) continue;
+    const auto& key = binding->key;
+    if (key.is_valid && !key.scaled_resolve && !key.signed_separate && key.base_page &&
+        key.dimension == xenos::DataDimension::k2DOrStacked &&
+        key.GetDepthOrArraySize() == 1 && key.GetWidth() == 1440 && key.GetHeight() == 1344 &&
+        uint32_t(key.format) == 20 && key.pitch == 48 && uint32_t(key.endianness) == 1 &&
+        key.tiled && !key.packed_mips && !key.mip_max_level && !key.mip_page &&
+        binding->texture && !binding->texture->hd_replacement()) mask |= uint32_t(1) << i;
+  }
+  return mask;
+}
+
+void TextureCache::RecordEffectsSampling(uint32_t candidate_mask, const char* backend,
+    uint64_t vertex_shader_hash, uint64_t pixel_shader_hash,
+    const std::vector<effects_diagnostics::Sampler>& samplers) const {
+  if (!effects_diagnostics::Enabled()) return;
+  // No GPU readback, shader/material changes or texture bytes are emitted.
+  // The CPU source snapshot is observational, not a proof of the later GPU draw.
+  try {
+    const auto& regs = register_file();
+    for (uint32_t i = 0; i < xenos::kTextureFetchConstantCount; ++i) {
+      if (!(candidate_mask & (uint32_t(1) << i))) continue;
+      const auto* binding = GetValidTextureBinding(i);
+      if (!binding || !binding->texture || binding->texture->outdated_mask()) continue;
+      const auto& key = binding->key;
+      const auto layout = key.GetGuestLayout();
+      if (layout.base.level_data_extent_bytes != 2162688 ||
+          layout.base.row_pitch_bytes != 6144 || layout.mips_total_extent_bytes) continue;
+      std::ostringstream state;
+      state << "{\"backend\":\"" << backend << "\",\"vs_hash\":" << vertex_shader_hash
+        << ",\"ps_hash\":" << pixel_shader_hash << ",\"fetch\":" << i
+        << ",\"base_page\":" << key.base_page
+        << ",\"host_resource_id\":" << binding->texture->host_resource_identity()
+        << ",\"scale_x\":" << draw_resolution_scale_x()
+        << ",\"scale_y\":" << draw_resolution_scale_y() << ",\"samplers\":[";
+      bool first = true;
+      for (const auto& s : samplers) {
+        if (s.fetch != i) continue;
+        if (!first) state << ',';
+        first = false;
+        state << "{\"stage\":" << s.stage << ",\"fetch\":" << s.fetch
+          << ",\"instruction_mag\":" << s.instruction_mag
+          << ",\"instruction_min\":" << s.instruction_min
+          << ",\"instruction_mip\":" << s.instruction_mip
+          << ",\"instruction_aniso\":" << s.instruction_aniso
+          << ",\"host_value\":" << s.host_value << ",\"mag_linear\":" << s.mag_linear
+          << ",\"min_linear\":" << s.min_linear << ",\"mip_linear\":" << s.mip_linear
+          << ",\"aniso\":" << s.aniso << ",\"mip_min_level\":" << s.mip_min_level
+          << ",\"mip_base_map\":" << s.mip_base_map << ",\"clamp_x\":" << s.clamp_x
+          << ",\"clamp_y\":" << s.clamp_y << ",\"clamp_z\":" << s.clamp_z
+          << ",\"border\":" << s.border << '}';
+      }
+      // A texture reference without a sampler binding cannot establish sampling.
+      if (first) continue;
+      state << "],\"fetch_raw\":[";
+      const auto fetch = regs.GetTextureFetch(i);
+      const auto* fetch_bytes = reinterpret_cast<const unsigned char*>(&fetch);
+      for (size_t word = 0; word < sizeof(fetch) / sizeof(uint32_t); ++word) {
+        uint32_t value;
+        std::memcpy(&value, fetch_bytes + word * sizeof(uint32_t), sizeof(value));
+        if (word) state << ',';
+        state << value;
+      }
+      state << "],\"guest_registers_raw\":{";
+      first = true;
+#define ASTER_EFFECTS_REG(name) do { \
+        if (!first) state << ','; first = false; \
+        state << "\"" #name "\":" << regs[XE_GPU_REG_##name]; \
+      } while (false)
+      ASTER_EFFECTS_REG(RB_COLORCONTROL);
+      ASTER_EFFECTS_REG(RB_ALPHA_REF);
+      ASTER_EFFECTS_REG(RB_BLENDCONTROL0);
+      ASTER_EFFECTS_REG(RB_BLENDCONTROL1);
+      ASTER_EFFECTS_REG(RB_BLENDCONTROL2);
+      ASTER_EFFECTS_REG(RB_BLENDCONTROL3);
+      ASTER_EFFECTS_REG(RB_BLEND_RED);
+      ASTER_EFFECTS_REG(RB_BLEND_GREEN);
+      ASTER_EFFECTS_REG(RB_BLEND_BLUE);
+      ASTER_EFFECTS_REG(RB_BLEND_ALPHA);
+      ASTER_EFFECTS_REG(RB_COLOR_MASK);
+      ASTER_EFFECTS_REG(RB_SURFACE_INFO);
+      ASTER_EFFECTS_REG(RB_COLOR_INFO);
+      ASTER_EFFECTS_REG(RB_COLOR1_INFO);
+      ASTER_EFFECTS_REG(RB_COLOR2_INFO);
+      ASTER_EFFECTS_REG(RB_COLOR3_INFO);
+      ASTER_EFFECTS_REG(RB_DEPTH_INFO);
+      ASTER_EFFECTS_REG(RB_DEPTHCONTROL);
+      ASTER_EFFECTS_REG(RB_MODECONTROL);
+      ASTER_EFFECTS_REG(PA_CL_VPORT_XSCALE);
+      ASTER_EFFECTS_REG(PA_CL_VPORT_XOFFSET);
+      ASTER_EFFECTS_REG(PA_CL_VPORT_YSCALE);
+      ASTER_EFFECTS_REG(PA_CL_VPORT_YOFFSET);
+      ASTER_EFFECTS_REG(PA_CL_VPORT_ZSCALE);
+      ASTER_EFFECTS_REG(PA_CL_VPORT_ZOFFSET);
+      ASTER_EFFECTS_REG(PA_CL_VTE_CNTL);
+      ASTER_EFFECTS_REG(PA_SC_WINDOW_SCISSOR_TL);
+      ASTER_EFFECTS_REG(PA_SC_WINDOW_SCISSOR_BR);
+      ASTER_EFFECTS_REG(PA_SC_WINDOW_OFFSET);
+      ASTER_EFFECTS_REG(PA_SC_SCREEN_SCISSOR_TL);
+      ASTER_EFFECTS_REG(PA_SC_SCREEN_SCISSOR_BR);
+      ASTER_EFFECTS_REG(PA_SU_SC_MODE_CNTL);
+#undef ASTER_EFFECTS_REG
+      const auto cc = regs.Get<reg::RB_COLORCONTROL>();
+      const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+      state << "},\"alpha_test_enable\":" << cc.alpha_test_enable
+        << ",\"alpha_func\":" << uint32_t(cc.alpha_func)
+        << ",\"alpha_to_mask_enable\":" << cc.alpha_to_mask_enable
+        << ",\"guest_msaa_samples_enum\":" << uint32_t(surface.msaa_samples)
+        << ",\"guest_surface_pitch\":" << surface.surface_pitch << '}';
+      const auto state_text = state.str();
+      if (!effects_diagnostics::Budget().Reserve(state_text)) continue;
+      std::vector<uint8_t> snapshot;
+      if (!shared_memory().TrySnapshotCpuTexture(key.base_page << 12,
+          layout.base.level_data_extent_bytes, snapshot)) continue;
+      const auto fingerprint = rex::hash_bytes(std::string_view(
+          reinterpret_cast<const char*>(snapshot.data()), snapshot.size()));
+      if (fingerprint != "20d7f7023b337e4a3b25e2d40cd10280" ||
+          binding->texture->outdated_mask()) continue;
+      REXGPU_INFO("ASTER_EFFECTS_META {{\"schema\":1,\"source_raw_xxh3_128\":\"{}\","
+          "\"snapshot_bytes\":{},\"gpu_written_pages\":false,\"actual_rt_size\":null,"
+          "\"actual_sampled_lod\":null,\"draw_completion\":\"unknown\",\"state\":{}}}",
+          fingerprint, snapshot.size(), state_text);
+    }
+  } catch (const std::exception&) {
+    // Metadata inspection must never turn a successful draw into a failure.
+  }
+}
